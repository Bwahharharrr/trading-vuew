{
  "name": "trading-vue-js",
  "version": "1.0.2",
  "description": "Hackable charting lib for traders",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.umd.ts",
    "./src/helpers/script_ww.js"
  ],
  "main": "./dist/trading-vue.js",
  "module": "./dist/trading-vue.es.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/trading-vue.min.js",
  "jsdelivr": "./dist/trading-vue.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/trading-vue.es.js",
      "require": "./dist/trading-vue.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "BUILD_TARGET=umd vite build && BUILD_TARGET=umd-min vite build && BUILD_TARGET=es vite build",
    "build:types": "vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run test/golden",
    "test:visual": "vitest run test/visual",
    "auto-test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .js,.vue src",
    "eslint": "eslint --ext .js,.vue src",
    "size": "size-limit",
    "smoke:gateway": "node scripts/corky-gateway-smoke.mjs",
    "smoke:positions": "node scripts/corky-positions-smoke.mjs",
    "smoke:browser": "node scripts/corky-browser-smoke.mjs",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage && npm run build && npm run size"
  },
  "size-limit": [
    {
      "name": "ESM (vue external, gzip)",
      "path": "dist/trading-vue.es.js",
      "limit": "130 kB"
    },
    {
      "name": "UMD min (vue bundled, gzip)",
      "path": "dist/trading-vue.min.js",
      "limit": "190 kB"
    },
    {
      "name": "tree-shake guard: import { defaultTheme } (full tree-shaking tracked)",
      "path": "dist/trading-vue.es.js",
      "import": "{ defaultTheme }",
      "limit": "91 kB"
    },
    {
      "name": "tree-shake guard: import { Utils }",
      "path": "dist/trading-vue.es.js",
      "import": "{ Utils }",
      "limit": "91 kB"
    },
    {
      "name": "tree-shake guard: import { defineOverlay }",
      "path": "dist/trading-vue.es.js",
      "import": "{ defineOverlay }",
      "limit": "91 kB"
    }
  ],
  "author": "C451",
  "license": "MIT",
  "files": [
    "dist/*",
    "src/*"
  ],
  "keywords": [
    "trading",
    "vue",
    "charts",
    "crypto",
    "visualization",
    "reactive",
    "algo-trading",
    "finviz",
    "trading-systems"
  ],
  "homepage": "https://github.com/C451/trading-vue-js#readme",
  "repository": "github:C451/trading-vue-js",
  "devDependencies": {
    "@size-limit/esbuild": "^11.2.0",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^7.21.0",
    "eslint-plugin-vue": "^9.0.0",
    "html2canvas": "^1.4.1",
    "httpxy": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "size-limit": "^11.2.0",
    "skia-canvas": "^2.0.2",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "arrayslicer": "^1.2.3",
    "hammerjs": "^2.0.8",
    "hamsterjs": "^1.1.3",
    "mitt": "^3.0.1",
    "vue": "^3.4.0"
  }
}
